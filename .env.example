# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=  # local development only: Google's free tier may use prompts to improve its products
# OLLAMA_URL=http://localhost:11434/v1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# The public record (Step 14): a SQLite file locally; Neon's connection string in production.
DATABASE_URL=sqlite:///data/records.db

# Limits (Step 12). PLAN=free fits Groq's free tier; PLAN=paid once you add a card (Step 18).
PLAN=free
VISITOR_DAILY_LIMIT=3

# A second AI provider, on separate infrastructure (Step 16). Leave empty to skip it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=